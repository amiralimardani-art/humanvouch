# HumanVouch web runtime configuration.
# Copy to packages/web/.env and replace the values. Every key is optional:
# without it the app falls back to the demo value in source.

# Cloudflare Turnstile server secret, read by server/api/verify-human.post.ts.
# Fallback: Cloudflare's public always-pass test secret (demo only, see SECURITY.md).
CF_TURNSTILE_SECRET=your-turnstile-secret-key

# Public runtime config (nuxt.config.ts -> runtimeConfig.public). Nuxt maps
# NUXT_PUBLIC_* variables onto these keys automatically at runtime.

# Soroban AttestContract id (testnet).
NUXT_PUBLIC_ATTEST_CONTRACT_ID=CDPDQJB7HX5XVOUHEDQKV6T7KJXNGVTVH3VDCXMFEE7GPIIINOVO5YZT
# Soroban RPC endpoint.
NUXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
# Stellar network passphrase.
NUXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Public key used as the source account for read-only contract simulations
# (also the x402 payTo address in server/api/v1/attestation.get.ts).
NUXT_PUBLIC_READ_SOURCE_PUBLIC_KEY=GDTLFJ4P2YYJRVO4ED4YQSC5MXKVXYNZPVZXIF3IB5WRMWRFKCJW7BPE
